{
  "expo": {
    "name": "BetKeyper",
    "slug": "bet-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#061733",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#061733"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jamesfaucett.bettracker"
    },
    "android": {
      "package": "com.jamesfaucett.bettracker",
      "adaptiveIcon": {
        "backgroundColor": "#061733",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "BetKeyper",
      "shortName": "BetKeyper",
      "themeColor": "#061733",
      "backgroundColor": "#061733"
    },
    "experiments": {
      "baseUrl": "/Bet-tracker-app"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#7BEA2B"
        }
      ]
    ]
  }
}
